# iRacing OAuth Client - Credentials Configuration
# Copy this file to .env and fill in your actual credentials
# NEVER commit the .env file to version control

# Client credentials (replace with your actual values)
IR_CLIENT_ID=your_client_id_here
IR_CLIENT_SECRET=your_client_secret_here

# User credentials (replace with your actual values)
IR_USERNAME=your_username@example.com
IR_PASSWORD=your_password_here
